{
  "name": "gateship",
  "version": "0.293.0",
  "module": "index.ts",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gateship-dev/gateship.git"
  },
  "engines": {
    "bun": ">=1.2.3"
  },
  "bin": {
    "gateship": "./index.ts",
    "gship": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "webui/dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build:release": "bun run build:ui && bash scripts/build-release.sh",
    "build:ui": "vite build webui",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit && bunx tsc -p webui/tsconfig.app.json --noEmit",
    "check:all": "bun run typecheck && bun test && bun run lint && bunx --bun knip",
    "lint": "bunx biome lint src scripts webui test --error-on-warnings",
    "verify": "bun run check:all"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.4",
    "knip": "6.24.0",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "react": "^19.2.8"
  }
}

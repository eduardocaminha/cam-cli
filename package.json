{
  "name": "cam-runtime",
  "version": "0.222.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "embed-vendor": "bun scripts/generate-embedded-vendor.ts",
    "embed-vendor:check": "bun scripts/generate-embedded-vendor.ts --check",
    "build:release": "bun scripts/generate-embedded-vendor.ts && bash scripts/build-release.sh",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "check:all": "bun scripts/check-all.ts",
    "check:ci-parity": "bun scripts/check-ci-parity.ts",
    "check:agents": "bun scripts/validate-agents-md.ts",
    "lint": "bunx biome lint --error-on-warnings",
    "verify": "bun scripts/check-all.ts",
    "test:container": "bun scripts/test-in-container.ts",
    "record:golden": "bun scripts/record-golden.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "ink-testing-library": "^4.0.0",
    "jscpd": "5.0.12",
    "knip": "6.24.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "chalk": "^5.6.2",
    "ink": "^7.0.3",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.1",
    "react": "^19.2.6",
    "react-devtools-core": "^7.0.1",
    "resend": "^6.16.0"
  }
}

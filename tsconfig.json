{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": false
  },
  // Exclude vendored upstream code from typecheck — those files target the
  // reporter monorepo's looser tsconfig (no `noUncheckedIndexedAccess`) and
  // are invoked by cam-cli via `bun <file>` at runtime, not as imports.
  // The drift smoke (`test/embedded.test.ts` + `bun run embed-vendor:check`) is
  // what guards them against regressions; static type checking is not the right
  // tool here.
  "exclude": ["node_modules", "vendor", "claude-code-harness"]
}

{
  "name": "cam worker container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "remoteUser": "bun",
  "mounts": [
    "source=claude-code-config,target=/home/bun/.claude,type=volume"
  ],
  "containerEnv": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "postStartCommand": "sudo bash /workspace/.devcontainer/init-firewall.sh"
}

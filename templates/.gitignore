# Ephemeral per-invocation worker exit report written by the cam agent (US-003).
# Never commit this file: it is overwritten on each worker invocation.
scripts/cam/worker-report.json
# Ephemeral per-review structured findings report written by the reviewer agent (US-001, CAM-75).
# Never commit this file: it is overwritten on each review invocation.
scripts/cam/review-report.json
# Ephemeral Layer B behavioral gate capture-pane artifact-of-record written by the reviewer agent (US-004).
# Never commit this file: it is overwritten on each review invocation.
scripts/cam/review-artifact.txt
# Ephemeral per-plan-audit verdict report written by the auditor agent (US-001, CAM-117).
# Never commit this file: it is overwritten on each plan-audit invocation.
scripts/cam/plan-verdict-report.json
# Ephemeral deterministic plan scope-proposal artifact written by the planner agent (US-002, CAM-52).
# Never commit this file: it is overwritten on each plan invocation.
scripts/cam/scope-proposal.json
# Durable plan-escalation marker written on plan non-convergence (US-002, CAM-204)
.claude/.cam-plan-escalated.json
# Durable worker-dispatch failure evidence (US-002, CAM-433)
.claude/.cam-dispatch-failed.json
# Durable sidecar-stalled marker written on firewall-init failure (US-001, CAM-207)
.claude/.cam-sidecar-stalled.json

# CAM-68: escaped harness runtime markers (orchestrator + setup + handoff + sidecar)
.claude/.cam-orchestrator-prompt.txt
.claude/.cam-task-prompt-*.txt
.claude/.cam-setup-menu.sh
.claude/.cam-setup-prompt.txt
.claude/.cam-orch-ready
.claude/.cam-sidecar.pid
.claude/.cam-watcher.pid
.claude/.cam-orch-handoff.json
.claude/.cam-orch-handoff.consumed.json
.claude/.cam-orch-recycle
.claude/.cam-orch-pid
# Inter-cycle drain kill-switch marker written by `cam drain --stop` (US-002, CAM-139)
.claude/.cam-drain-stop
# Operator pause brake marker written by `cam pause` (US-001, CAM-360)
.claude/.cam-pause
# Runtime per-story worker out-log (CAM-22/CAM-32, mirrored into templates/ by CAM-160)
.claude/.cam-worker-out-*.log
# CAM-433 (US-R1-001): implementer/reviewer pipe-pane out-log, written without a
# leading dot by runVerifiedWorkerDispatch (src/supervisor/worker-dispatch.ts);
# distinct from the legacy dotted .cam-worker-out-*.log pattern above.
.claude/cam-worker-out-*.log
# CAM-158: pipe-pane logs written by runPlanPhase (planner/auditor sessions), mirrored into templates/ by CAM-160
.claude/cam-plan-out-*.log
# Recycle watcher log written by spawnWatcherDefault in run.ts (US-004)
.claude/cam-recycle-watcher.log

# US-001, CAM-499: credentials the product docs tell users to put in .env at
# the project root (GITHUB_TOKEN, CLAUDE_CODE_OAUTH_TOKEN, RESEND_API_KEY).
# Agents running with bypassPermissions commit and push on their own, so this
# has to actually be ignored, not just documented. Covers the local-variant
# family generically (.env.local, .env.production.local, .env.test.local,
# .env.development.local, ...) without a blanket .env* that would also hide
# a legitimately-committed .env.example.
.env
.env.local
.env.*.local

# US-002, CAM-502: durable operator-decision + terminal-state markers written
# by the supervisor loop (parity with the repo's own .gitignore)
.claude/.cam-gate.json
.claude/.cam-implement-blocked.json
.claude/.cam-plan-preflight-failed.json
.claude/.cam-post-merge-stalled.json
.claude/.cam-ship-stalled.json
.claude/.cam-sidecar-session.json
# US-002, CAM-502: runtime session/concurrency markers written by `cam next` / `cam run`
.claude/.cam-orch-session
.claude/.cam-supervisor.lock
.claude/.cam-worker-pane
# US-002, CAM-502: sidecar liveness watcher stdout/stderr log + pid file
.claude/cam-sidecar-liveness-watcher.log
.claude/.cam-sidecar-liveness-watcher.pid
# US-002, CAM-502: merge-watch state written by MERGE_WATCH_FILENAME
.claude/.cam-merge-watch.json
# US-002, CAM-502: structured event log + gate-outcome history + per-run gate timing
.claude/cam-worker-events.jsonl
.claude/cam-gate-history.jsonl
.claude/cam-supervisor.log
gate-results.json

# Repo-local scratch root used by test runs (US-001, CAM-508); must never dirty the working tree
.cam-test-tmp/

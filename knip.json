{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "index.ts",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ],
  "ignore": [
    "scripts/preview-screens.ts",
    "scripts/ui-snapshot.tsx",
    "src/config/permission-mode.ts",
    "src/logging/format.ts",
    "test/fixtures/interactivity/mock-claude.ts",
    "vendor/**",
    "dist/**",
    "claude-code-harness/**"
  ],
  "ignoreBinaries": ["cam", "claude", "tmux", "ps", "lsof", "gh", "pgrep"],
  "ignoreDependencies": ["jscpd"],
  "ignoreExportsUsedInFile": true,
  "exclude": ["exports", "types", "duplicates"]
}

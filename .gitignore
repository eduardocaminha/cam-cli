.idea

# Finder (MacOS) folder config
.DS_Store

# Project-local Claude Code files materialized by `cam next` (gitignored by convention)
.claude/settings.local.json
.claude/hooks/
# Runtime orchestrator session-id marker written by `cam run` (US-002, CAM-21)
.claude/.cam-orch-session
# CAM-68: escaped harness runtime markers (orchestrator + setup + handoff + sidecar)
.claude/.cam-orchestrator-prompt.txt
.claude/.cam-setup-menu.sh
.claude/.cam-setup-prompt.txt
.claude/.cam-orch-ready
.claude/.cam-sidecar.pid
.claude/.cam-orch-handoff.json
.claude/.cam-orch-handoff.consumed.json
# Runtime per-story supervisor artifacts: session markers + durable out-logs (CAM-22/CAM-32)
.claude/.cam-worker-*.session
.claude/.cam-worker-out-*.log
# Runtime supervisor markers written by `cam plan` / `cam next` (CAM-22)
.claude/.cam-worker-pane
.claude/cam-loop.local.md
# Runtime structured event log written by the supervisor (US-013)
.claude/cam-worker-events.jsonl
# Runtime single-supervisor concurrency lock written by `cam next` (US-015)
.claude/.cam-supervisor.lock
# Supervisor console output log (runtime artifact; gitignored to prevent accidental commit)
.claude/cam-supervisor-out.log
# Sidecar supervisor log + cam next run log (runtime artifacts written by `cam run` / `cam next`, CAM-55)
.claude/cam-supervisor.log
.claude/cam-next-run.log
# Ephemeral per-invocation worker exit report (US-003/US-FIX-006; read by supervisor, never committed)
scripts/cam/worker-report.json

# Cursor IDE workspace files (content is already in CLAUDE.md, which Cursor reads as fallback)
.cursor/

# Cascade / Windsurf chat dumps
Refactor*.md

# Claude Code internal source mirror (local reference material; not part of cam-cli)
claude-code-harness/
